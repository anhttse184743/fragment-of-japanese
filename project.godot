; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="FRAGMENT OF JAPANESE"
run/main_scene="res://scenes/ui/AuthScreen.tscn"
config/features=PackedStringArray("4.7", "C#", "Mobile")
config/icon="res://icon.svg"

[audio]

driver/enable_input=true

[autoload]

PhantomCameraManager="*res://addons/phantom_camera/scripts/managers/phantom_camera_manager.gd"
AccountManager="*res://src/Autoloads/AccountManager.cs"
ItemDatabase="*res://src/Autoloads/ItemDatabase.cs"
JapaneseDB="*res://src/Autoloads/JapaneseDB.cs"
Inventory="*res://src/Items/Inventory.cs"
Wallet="*res://src/Items/Wallet.cs"
Shop="*res://src/Items/Shop.cs"
Gacha="*res://src/Items/Gacha.cs"
RedeemManager="*res://src/Items/RedeemManager.cs"
QuestManager="*res://src/Quests/QuestManager.cs"
LearningTracker="*res://src/Learning/LearningTracker.cs"
SkinManager="*res://src/Cosmetics/SkinManager.cs"
AdManager="*res://src/Ads/AdManager.cs"
InventoryUi="*res://src/Ui/InventoryUi.cs"
ShopUi="*res://src/Ui/ShopUi.cs"
LocaleManager="*res://src/Autoloads/LocaleManager.cs"
SceneTransition="*res://src/Autoloads/SceneTransition.cs"
ConfirmUi="*res://src/Ui/ConfirmUi.cs"
DialogueUi="*res://src/Ui/DialogueUi.cs"
ChallengeUi="*res://src/Ui/ChallengeUi.cs"
SaveSystem="*res://src/Autoloads/SaveSystem.cs"
GameManager="*res://src/Autoloads/GameManager.cs"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/resizable=false
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=2

[dotnet]

project/assembly_name="FRAGMENT OF JAPANESE"

[editor_plugins]

enabled=PackedStringArray("res://addons/phantom_camera/plugin.cfg")

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/ios/touch_delay=0.15

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=1024
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/positional_shadow/atlas_size=1024
