<Project Sdk="Godot.NET.Sdk/4.7.0">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>FRAGMENTOFJAPANESE</RootNamespace>
  </PropertyGroup>

  <!-- Quảng cáo THẬT (AdMob) — chỉ biên dịch cho bản Android; desktop/editor vẫn dùng Mock. -->
  <PropertyGroup Condition=" '$(GodotTargetPlatform)' == 'android' ">
    <DefineConstants>$(DefineConstants);ADMOB_ENABLED</DefineConstants>
  </PropertyGroup>
</Project>